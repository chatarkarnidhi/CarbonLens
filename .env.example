# =================================================================
# CarbonLens Frontend Environment Variables (Vite)
# =================================================================
# In production on AWS Amplify, set VITE_API_BASE_URL to your deployed
# Lambda Function URL or API Gateway HTTPS endpoint.
# In local development, leave blank to use the Vite proxy (/api -> local backend).
VITE_API_BASE_URL=

# Optional: Override local dev backend port/URL if not using default http://127.0.0.1:3001
VITE_DEV_BACKEND_URL=http://127.0.0.1:3001

# =================================================================
# CarbonLens Backend Environment Variables (Node.js / Lambda)
# =================================================================
# Target AWS Region for CloudWatch metrics (Europe/Stockholm)
AWS_REGION=eu-north-1

# Target EC2 Instance ID and Metadata
EC2_INSTANCE_ID=i-03ab13867b4511011
EC2_INSTANCE_NAME=CarbonLens-Test-Workload
EC2_INSTANCE_TYPE=t3.micro

# Allowed Frontend Origins for CORS in production (e.g., https://main.d123456.amplifyapp.com)
# Comma-separated list for multiple domains
ALLOWED_ORIGIN=https://main.d123456.amplifyapp.com

# Local server port (default: 3001)
PORT=3001
HOST=127.0.0.1
